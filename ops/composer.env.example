# Composer user-service environment.
# Installed location: ~/.config/composer/composer.env
# Permissions should be 0600 because this file stores secrets.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=42456
COMPOSER_HOSTNAME=127.0.0.1

# Local persistent connector store. The installer writes an absolute path such as:
# CONNECTOR_STORE_PATH=/home/<user>/.local/share/composer/connectors.json
CONNECTOR_STORE_PATH=
COMPOSER_CONFIG_DIR=
COMPOSER_DATA_DIR=

# Generate with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=

# Required by connector API routes until real app auth exists.
# Generate with: openssl rand -base64 32
COMPOSER_CONNECTOR_ADMIN_TOKEN=
