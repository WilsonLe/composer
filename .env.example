# Required before using connector APIs.
# Generate with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=

# Required before using connector APIs. Send as:
# Authorization: Bearer <token>
# or X-Composer-Admin-Token: <token>
COMPOSER_CONNECTOR_ADMIN_TOKEN=

# Optional in development. Defaults to .data/connectors.json.
# The systemd user service writes an absolute path such as:
# CONNECTOR_STORE_PATH=/home/<user>/.local/share/composer/connectors.json
CONNECTOR_STORE_PATH=.data/connectors.json

# Optional local listener defaults. The systemd user service defaults to 127.0.0.1:3000.
HOSTNAME=127.0.0.1
PORT=3000
