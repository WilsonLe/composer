# Required before saving connector credentials.
# Generate with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=

# Optional in development. Defaults to .data/connectors.json.
# The systemd user service writes an absolute path such as:
# CONNECTOR_STORE_PATH=/home/<user>/.local/share/composer/connectors.json
CONNECTOR_STORE_PATH=.data/connectors.json

# Optional local listener defaults. The systemd user service defaults to 127.0.0.1:42456.
# Connector APIs are unauthenticated, so keep COMPOSER_HOSTNAME on 127.0.0.1
# unless another trusted layer protects the app.
COMPOSER_HOSTNAME=127.0.0.1
PORT=42456
